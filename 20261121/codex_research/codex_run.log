   129	  A, Bd = out['A'], out['B']
   130	  Q0, u0 = qvals(Wo0, Wg0, A['c'], A['X'])
   131	  Q1, _ = qvals(Wo1, Wg1, A['c'], A['X'])
   132	  dQ = Q1 - Q0
   133	  # first-order prediction from the W_g change
   134	  dWgx = np.einsum('nd,sad->san', Wg1 - Wg0, A['X'])

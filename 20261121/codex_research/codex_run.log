    71	  def _obs(self, reward, is_first=False, is_last=False, is_terminal=False):
    72	    with self._jax.transfer_guard('allow'):
    73	      img = np.asarray(self._timestep.observation, np.uint8)
    74	    H, W = self._size
    75	    h, w = img.shape[:2]
    76	    top, left = (H - h) // 2, (W - w) // 2
    77	    image = np.zeros((H, W, 3), np.uint8)
    78	    image[top:top + h, left:left + w] = img
    79	    return dict(
    80	        image=image,
    81	        reward=np.float32(reward),
    82	        is_first=is_first,
    83	        is_last=is_last,
    84	        is_terminal=is_terminal,
    85	    )
     1	"""Where does the W_g change from new-task learning hit old-task Q?
     2	
     3	Loads the agent before new-task learning, runs stored trajectories of the
     4	old task (A) and new task (B) through the frozen world model to get
     5	c = h_t and x(a) = normalized h_{t+1}(a) for every action. The world model
     6	is frozen during new-task learning, so c and x are the same before and after.
     7	With W_o fixed (freeze_wo run), the only change is W_g:
     8	
     9	  Q(s, a) = sum_i W_o,i c_i silu(W_g,i . x(a))          (dsyn left out)
    10	
    11	Reports, on old-task states:
    12	  - exact change of Q and of the policy softmax(Q / tau), before -> after
    13	  - first-order prediction  dQ ~ sum_i W_o,i c_i silu'(u_i) (dW_g,i . x)
    14	  - per-unit spread of that change (how many units carry it)
    15	and the two overlap factors of a single new-task write on an old-task read:
    16	  unit overlap   sum_i W_o,i^2 c_A,i c_B,i silu'_A,i silu'_B,i (cosine-normed)
    17	  input overlap  x_A . x_B (cosine)
    18	compared with the same quantities within the old task.
    19	
    20	python dreamerv3/diag_overlap.py --before <agent ckpt> --after <agent ckpt> \
    21	  --replay_a <old-task replay> --replay_b <new-task replay> --out <json>
    22	"""

   206	  def _candidates(self, deter, stoch, raw=False):
   207	    """x(s, a) = h_{t+1}(a) for every action, plus the prior stoch."""
   208	    B, A = deter.shape[0], self.nact
   209	    rep = lambda x: jnp.repeat(x, A, 0)
   210	    carry = dict(deter=rep(deter), stoch=rep(stoch))
   211	    acts = {'action': jnp.tile(jnp.arange(A, dtype=jnp.int32), B)}
   212	    _, (feat, _) = self.dyn.imagine(carry, acts, 1, False, single=True)
   213	    unrep = lambda x: x.reshape((B, A, *x.shape[1:]))
   214	    Draw = unrep(feat['deter'])
   215	    X = f32(Draw)
   216	    if self.qcfg.xnorm:
   217	      X = X / jnp.sqrt((X ** 2).mean(-1, keepdims=True) + 1e-8)
   218	    if raw:
   219	      return X, unrep(feat['stoch']), Draw
   220	    return X, unrep(feat['stoch'])

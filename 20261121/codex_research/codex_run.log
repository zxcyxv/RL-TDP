import pathlib
import pickle
import tempfile

import elements
import numpy as np
import ruamel.yaml as yaml

from dreamerv3 import main
from dreamerv3.diag_features import load_streams
from dreamerv3.diag_overlap import features, dsilu, qvals

root = pathlib.Path('/workspace/ext/logs')
base = root / '20261121_0412_q_dk8_target_tracenorm_eta02' / 'ckpt_steps/01800000'
current = root / '20261121_0540_learn_unlock_freezewo'
prec = root / '20261121_0633_learn_unlock_freezewo_prec'
old = root / '20261121_0515_eval_dk8_before'
P = np.load('/workspace/RL-TDP/20261121/logs/20261121_P_dk8_alpha1.npy')
cfg = yaml.YAML(typ='safe').load(pathlib.Path('dreamerv3/configs.yaml').read_text())
config = elements.Config(cfg['defaults']).update(cfg['size1m'])

def params(path):
    with (path / 'agent.pkl').open('rb') as f:
        return pickle.load(f)['params']

def trace_metrics(group, current_context, all_inputs, data, wo, wg):
    times, batch, actions, width = all_inputs.shape
    xs = np.take_along_axis(all_inputs, data['action'][..., None, None], axis=2)[:, :, 0]
    u = xs @ wg.T
    s = u / (1.0 + np.exp(-u))
    g_o = current_context * s
    co = wo * current_context * dsilu(u)
    x_p = xs @ P
    tsel = ~(data['is_last'][:-1] | data['is_first'][1:])
    tau = 0.99 * 0.9
    eo = np.zeros((batch, width), np.float32)
    ep = np.zeros((batch, width, width), np.float32)
    ei = np.zeros_like(ep)
    outputs = []
    for t in range(times - 1):
        keep = ~data['is_first'][t]
        eo *= (tau * keep[:, None]).astype(np.float32)
        ei *= (tau * keep[:, None, None]).astype(np.float32)
        ep *= (tau * keep[:, None, None]).astype(np.float32)
        eo += g_o[t]
        ei += co[t, :, :, None] * xs[t, :, None, :]
        ep += co[t, :, :, None] * x_p[t, :, None, :]
        pself = np.einsum('bd,bd->b', xs[t], x_p[t]) / np.einsum('bd,bd->b', xs[t], xs[t])
        eo2 = np.einsum('bn,bn->b', eo, eo)
        i2 = np.einsum('bnd,bnd->b', ei, ei)
        p2 = np.einsum('bnd,bnd->b', ep, ep)
        denom_i = eo2 + i2 + 1e-6
        denom_p = eo2 + p2 + 1e-6
        v_i = np.einsum('bn,bnd,bd->b', co[t], ei, xs[t]) / denom_i
        v_p = np.einsum('bn,bnd,bd->b', co[t], ep, xs[t]) / denom_p
        outputs.append(np.stack([pself, np.sqrt(p2 / (i2 + 1e-20)),
                                 v_i, v_p, (v_p / (v_i + 1e-20)),
                                 (np.sqrt(p2) / denom_p) / (np.sqrt(i2) / denom_i + 1e-20)], -1)[tsel[t]])
    rows = np.concatenate(outputs, axis=0)
    print(group, 'paired traces n=', len(rows), 'median', np.median(rows, axis=0),
          'p10/p90 actual signed self-gain ratio', np.quantile(rows[:, 4], [.1, .9]), flush=True)
    return xs[~data['is_last']].reshape(-1, width).astype(np.float64)

base_p = params(base)
w0, o0 = base_p['q/Wg'], base_p['q/Wo']
with tempfile.TemporaryDirectory(prefix='rltdp-readonly-diag-') as tmp:
    config = elements.Flags(config).parse([
        '--task', 'navix_DoorKey-8x8-v0', '--agent_type', 'q',

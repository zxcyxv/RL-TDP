   101	  elements.Path(config.logdir).mkdir()
   102	  agent = mainmod.make_agent(config)
   103	  elements.checkpoint.load(args.before, dict(agent=agent.load))
   104	
   105	  P0 = pickle.load(open(pathlib.Path(args.before) / 'agent.pkl', 'rb'))['params']
   106	  P1 = pickle.load(open(pathlib.Path(args.after) / 'agent.pkl', 'rb'))['params']
   107	  Wo0, Wg0 = np.asarray(P0['q/Wo'], np.float64), np.asarray(P0['q/Wg'], np.float64)
   108	  Wo1, Wg1 = np.asarray(P1['q/Wo'], np.float64), np.asarray(P1['q/Wg'], np.float64)
   109	  res = {'Wo_change_rel': float(np.linalg.norm(Wo1 - Wo0) / np.linalg.norm(Wo0)),
   110	         'Wg_change_rel': float(np.linalg.norm(Wg1 - Wg0) / np.linalg.norm(Wg0))}
   111	
   112	  out = {}
   113	  for name, rdir in (('A', args.replay_a), ('B', args.replay_b)):
   114	    data = load_streams(rdir, args.streams, args.steps)
   115	    c, X = features(agent, data)
   116	    T, B = c.shape[:2]
   117	    # states near the end of successful episodes (old task: after the door)
   118	    near = np.zeros((T, B), bool)
   119	    for b in range(B):

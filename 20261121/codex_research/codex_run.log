   293	    step_d = q.beta * delta_u / gn
   294	    step_o = q.eta * delta_u / gn
   295	    dsyn = qc['dsyn'] + step_d[:, None, None] * qc['e_d']
   296	    dWo = step_o[:, None] * qc['e_o']

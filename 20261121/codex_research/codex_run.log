import numpy as np

rng = np.random.default_rng(20261121)
x, y = rng.normal(size=(1024, 12)), rng.normal(size=(1024, 4))
mu = .4
J = np.eye(x.shape[1]) / mu
M = np.zeros((y.shape[1], x.shape[1]))
for k, target in zip(x, y):
    K = J @ k / (1 + k @ J @ k)
    M += np.outer(target - M @ k, K)
    J -= np.outer(K, k @ J)
S = x.T @ x + mu * np.eye(x.shape[1])
batch = np.linalg.solve(S, x.T @ y).T
err, je = np.max(np.abs(M - batch)), np.max(np.abs(J - np.linalg.inv(S)))
np.testing.assert_allclose(M, batch, atol=1e-12)
np.testing.assert_allclose(J, np.linalg.inv(S), atol=1e-12)
print(f'RLS vs batch max |dM|={err:.3g}, max |dJ|={je:.3g}')

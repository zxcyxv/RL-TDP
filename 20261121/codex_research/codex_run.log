   184	  def init_policy(self, batch_size):
   185	    zeros = lambda x: jnp.zeros((batch_size, *x.shape), x.dtype)
   186	    return (
   187	        self.enc.initial(batch_size),
   188	        self.dyn.initial(batch_size),
   189	        self.dec.initial(batch_size),
   190	        jax.tree.map(zeros, self.act_space),
   191	        self._qcarry(batch_size))

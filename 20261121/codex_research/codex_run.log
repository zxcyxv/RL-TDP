    89	def ridge_r2(Xtr, ytr, Xte, yte, lam=1e-2):
    90	  mu, sd = Xtr.mean(0), Xtr.std(0) + 1e-8
    91	  A, B = (Xtr - mu) / sd, (Xte - mu) / sd
    92	  ym = ytr.mean()
    93	  w = np.linalg.solve(A.T @ A + lam * len(A) * np.eye(A.shape[1]), A.T @ (ytr - ym))
    94	  pred = B @ w + ym
    95	  return 1 - ((yte - pred) ** 2).sum() / ((yte - yte.mean()) ** 2).sum()

   107	  def __init__(self, obs_space, act_space, config):
   108	    self.obs_space = obs_space
   109	    self.act_space = act_space
   110	    self.config = config
   111	    assert list(act_space.keys()) == ['action'], act_space
   112	    assert act_space['action'].discrete
   113	    self.nact = int(np.asarray(act_space['action'].classes).flatten()[0])
   114	
   115	    exclude = ('is_first', 'is_last', 'is_terminal', 'reward')
   116	    enc_space = {k: v for k, v in obs_space.items() if k not in exclude}
   117	    dec_space = {k: v for k, v in obs_space.items() if k not in exclude}
   118	    self.enc = rssm.Encoder(enc_space, **config.enc.simple, name='enc')
   119	    self.dyn = rssm.RSSM(act_space, **config.dyn.rssm, name='dyn')
   120	    self.dec = rssm.Decoder(dec_space, **config.dec.simple, name='dec')
   121	    self.feat2tensor = lambda x: jnp.concatenate([
   122	        nn.cast(x['deter']),
   123	        nn.cast(x['stoch'].reshape((*x['stoch'].shape[:-2], -1)))], -1)
   124	    scalar = elements.Space(np.float32, ())
   125	    binary = elements.Space(bool, (), 0, 2)
   126	    self.rew = embodied.jax.MLPHead(scalar, **config.rewhead, name='rew')
   127	    self.con = embodied.jax.MLPHead(binary, **config.conhead, name='con')
   128	
   129	    q = config.q
   130	    self.qcfg = q
   131	    # precision matrix over old-task inputs: dsyn writes use P x instead of x
   132	    self.Pmat = jnp.asarray(np.load(q.precision), f32) if q.precision else None
   133	    deter = config.dyn.rssm.deter
   134	    self.qhead = QHead(deter, deter, q.gscale, q.seed, q.wo_std, name='q')
   135	
   136	    self.modules = [self.dyn, self.enc, self.dec, self.rew, self.con]
   137	    self.opt = embodied.jax.Optimizer(
   138	        self.modules, self._make_opt(**config.opt), summary_depth=1,
   139	        name='opt')
   140	    scales = self.config.loss_scales.copy()
   141	    rec = scales.pop('rec')
   142	    scales.update({k: rec for k in dec_space})
   143	    for k in ('policy', 'value', 'repval'):
   144	      scales.pop(k)
   145	    self.scales = scales

   152	    def _reset(self, key: Array, cache: Union[RenderingCache, None] = None) -> Timestep:
   153	        key, grid, _, entities, _, _ = two_equal_rooms_with_door(
   154	            key, self.height, self.width
   155	        )
   156	
   157	        state = State(
   158	            key=key,
   159	            grid=grid,
   160	            cache=cache or RenderingCache.init(grid),
   161	            entities=entities,
   162	        )
   163	        return Timestep(
   164	            t=jnp.asarray(0, dtype=jnp.int32),
   165	            observation=self.observation_fn(state),
   166	            action=jnp.asarray(-1, dtype=jnp.int32),
   167	            reward=jnp.asarray(0.0, dtype=jnp.float32),
   168	            step_type=jnp.asarray(0, dtype=jnp.int32),
   169	            state=state,
   170	        )

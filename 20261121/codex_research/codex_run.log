     6	class Navix(embodied.Env):
     7	  """NAVIX (JAX MiniGrid) task, e.g. task='DoorKey-8x8-v0'.
     8	
     9	  Observation: rgb_first_person (7x7 tiles of 8x8 px = 56x56x3), zero-padded
    10	  to `size` so the DreamerV3 CNN sees a power-of-two resolution. The NAVIX
    11	  step runs on the CPU so env worker processes do not touch the GPU.
    12	  """
    13	
    14	  def __init__(self, task, size=(64, 64), seed=None):
    15	    import multiprocessing
    16	    import jax
    17	    if multiprocessing.parent_process() is not None:
    18	      # Env worker (spawned by the driver): keep it off the GPU entirely, so
    19	      # it creates no GPU client and preallocates no GPU memory. In the main
    20	      # process the agent uses the GPU; there we only pin NAVIX to the CPU.
    21	      jax.config.update('jax_platforms', 'cpu')
    22	    self._jax = jax
    23	    self._cpu = jax.devices('cpu')[0]
    24	    with jax.default_device(self._cpu), jax.transfer_guard('allow'):
    25	      import navix as nx
    26	      self._env = nx.make(
    27	          f'Navix-{task}',
    28	          observation_fn=nx.observations.rgb_first_person)
    29	      self._reset = jax.jit(self._env.reset)
    30	      self._step = jax.jit(self._env.step)
    31	      self._key = jax.random.PRNGKey(0 if seed is None else seed)
    32	    self._size = tuple(size)
    33	    self._nact = int(self._env.action_space.maximum) + 1
    34	    self._timestep = None
    35	    self._done = True
    36	
    37	  @property
    38	  def obs_space(self):
    39	    return {
    40	        'image': elements.Space(np.uint8, (*self._size, 3)),
    41	        'reward': elements.Space(np.float32),
    42	        'is_first': elements.Space(bool),
    43	        'is_last': elements.Space(bool),
    44	        'is_terminal': elements.Space(bool),
    45	    }
    46	
    47	  @property
    48	  def act_space(self):
    49	    return {
    50	        'action': elements.Space(np.int32, (), 0, self._nact),
    51	        'reset': elements.Space(bool),
    52	    }
    53	
    54	  def step(self, action):
    55	    jax = self._jax
    56	    with jax.default_device(self._cpu), jax.transfer_guard('allow'):
    57	      if action['reset'] or self._done:
    58	        self._key, key = jax.random.split(self._key)
    59	        self._timestep = self._reset(key)
    60	        self._done = False
    61	        return self._obs(0.0, is_first=True)
    62	      self._timestep = self._step(
    63	          self._timestep, np.int32(action['action']))
    64	      step_type = int(self._timestep.step_type)  # 0 transition, 1 trunc, 2 term
    65	      reward = float(self._timestep.reward)
    66	    self._done = step_type != 0
    67	    return self._obs(
    68	        reward,
    69	        is_last=self._done, is_terminal=(step_type == 2))

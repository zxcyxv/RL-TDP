   153	  def _qcarry(self, B):
   154	    n = d = self.config.dyn.rssm.deter
   155	    return dict(
   156	        dsyn=jnp.zeros((B, n, d), f32),
   157	        e_d=jnp.zeros((B, n, d), f32),
   158	        e_o=jnp.zeros((B, n), f32),
   159	        gn_d=jnp.zeros((B,), f32),
   160	        gn_o=jnp.zeros((B,), f32),
   161	        ge=jnp.zeros((B,), f32),
   162	        q_prev=jnp.zeros((B,), f32),
   163	        valid=jnp.zeros((B,), bool),

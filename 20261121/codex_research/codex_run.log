   314	    qc['gn_o'] = (g_o ** 2).sum(-1)
   315	    qc['gn_d'] = (coef ** 2).sum(-1) * (x_w ** 2).sum(-1)
   316	    # g . e for this transition (trace already includes g)
   317	    qc['ge'] = (g_o * qc['e_o']).sum(-1) + jnp.einsum(
   318	        'bn,bnd,bd->b', coef, qc['e_d'], x_a)
   319	    qc['q_prev'] = take(Q, a)
   320	    qc['valid'] = jnp.ones_like(valid)
   321	    qc['dsyn'] = dsyn
   322	    # Shared-weight side, computed here so the wrapper only swaps arrays in:
   323	    # summed online W_o updates, and transfer of dsyn into W_g for every
   324	    # environment whose episode ends at this step (dsyn is cleared at the
   325	    # next episode start).
   326	    last = obs['is_last'].astype(f32)
   327	    # Mean over the environments with a valid transition at this step (as a
   328	    # batch mean); env_mean False keeps the old sum.
   329	    nvalid = jnp.maximum(valid.sum(), 1).astype(f32)
   330	    qc['Wo_new'] = Wo + (dWo.sum(0) / nvalid if q.env_mean else dWo.sum(0))
   331	    qc['Wg_new'] = Wg + jnp.einsum('b,bnd->nd', last, dsyn)
   332	    # targets follow the online weights slowly (as DreamerV3 slowvalue)
   333	    if q.freeze_wo:
   334	      # W_o fixed; dsyn and the dsyn -> W_g transfer still learn
   335	      qc['Wo_new'] = Wo
   336	    if q.frozen:
   337	      # evaluation: dsyn still works inside the episode, but nothing is
   338	      # written into the shared weights (no W_o update, no transfer)
   339	      qc['Wo_new'], qc['Wg_new'] = Wo, Wg
   340	    k = 0.0 if q.frozen else q.target_rate
   341	    qc['Wo_t_new'] = (1 - k) * Wo_t + k * qc['Wo_new']
   342	    qc['Wg_t_new'] = (1 - k) * Wg_t + k * qc['Wg_new']
   343	    nv = jnp.maximum(valid.sum(), 1)
   344	    wdir = Wo / (jnp.linalg.norm(Wo) + 1e-8)
   345	    proj = dWo @ wdir                                   # [B] signed growth
   346	    rpos = (r > 0).astype(f32)
   347	    agg = (lambda x: x.sum(0) / nvalid) if q.env_mean else (lambda x: x.sum(0))
   348	    # Exact split of delta (linear in dWo):
   349	    #   delta = r + (g' - 1) * q_prev + g' * (V - q_prev),  g' = gamma*(1-term)
   350	    # discount term (g' - 1) * q_prev, change term g' * (V - q_prev).
   351	    gp = q.gamma * (1 - term)
   352	    d_disc = jnp.where(valid, (gp - 1) * q_prev_old, 0.0)
   353	    d_chg = jnp.where(valid, gp * (V - q_prev_old), 0.0)
   354	    per_delta = jnp.where(jnp.abs(delta) > 0, proj / jnp.where(
   355	        jnp.abs(delta) > 0, delta, 1.0), 0.0)        # projection per unit delta
   356	    zero = valid.astype(f32) * (1 - rpos)
   357	    nz = jnp.maximum(zero.sum(), 1)
   358	    qc['stats'] = dict(
   359	        dWo_zero_disc_cum=qc['stats']['dWo_zero_disc_cum'][0] + agg(
   360	            per_delta * d_disc * zero),
   361	        dWo_zero_chg_cum=qc['stats']['dWo_zero_chg_cum'][0] + agg(
   362	            per_delta * d_chg * zero),
   363	        zero_q_prev=(q_prev_old * zero).sum() / nz,
   364	        zero_V=(V * zero).sum() / nz,
   365	        dWo_pos_cum=qc['stats']['dWo_pos_cum'][0] + agg(proj * rpos),
   366	        dWo_zero_cum=qc['stats']['dWo_zero_cum'][0] + agg(proj * (1 - rpos)),
   367	        delta_abs=jnp.abs(delta).sum() / nv,
   368	        delta_max=jnp.abs(delta).max(),
   369	        dsyn_norm=jnp.sqrt((dsyn ** 2).sum((1, 2))).mean(),
   370	        q_sel=take(Q, a).mean(),
   371	        u_std=u_a.std(),
   372	        transfers=qc['stats']['transfers'][0] + last.sum(),
   373	        tau=jnp.asarray(tau, f32),
   374	        pi_maxprob=jax.nn.softmax(logits, -1).max(-1).mean(),
   375	        ret_scale=jnp.asarray(ret_scale, f32),
   376	        cap_frac=(jnp.where(valid, qc_ge_prev > qc_gg_prev, False).sum()
   377	                  / nv).astype(f32),
   378	        ge_ratio=(jnp.where(valid, qc_ge_prev / (qc_gg_prev + q.eps), 0.0).sum()
   379	                  / nv).astype(f32),
   380	    )
   381	    # Rank-1 so the batch sharding of the policy carry applies.
   382	    qc['stats'] = jax.tree.map(lambda x: x.reshape((1,)), qc['stats'])
   383	
   384	    out = {}
   385	    if q.debug_outs:
   386	      out['qdbg/K'] = c[:, None, :] * s       # features for every action
   387	      out['qdbg/Xn'] = X                       # normalized x for every action
   388	      out['qdbg/c'] = c
   389	      out['qdbg/Q'] = Q

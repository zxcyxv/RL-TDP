   222	  def policy(self, carry, obs, mode='train'):
   222	  def policy(self, carry, obs, mode='train'):
   223	    (enc_carry, dyn_carry, dec_carry, prevact, qc) = carry
   224	    q = self.qcfg
   225	    kw = dict(training=False, single=True)
   226	    reset = obs['is_first']
   227	    enc_carry, enc_entry, tokens = self.enc(enc_carry, obs, reset, **kw)
   228	    dyn_carry, dyn_entry, feat = self.dyn.observe(
   229	        dyn_carry, tokens, prevact, reset, **kw)
   230	    dec_entry = {}
   231	
   232	    Wg, Wo = self.qhead()
   233	    Wg_t, Wo_t = self.qhead.targets() if q.target else (Wg, Wo)
   234	    c = f32(feat['deter'])
   235	    X, _ = self._candidates(feat['deter'], feat['stoch'])
   236	
   237	    # Episode start: clear the fast synapse and the traces.
   238	    keep = (~reset).astype(f32)
   239	    qc = dict(qc)
   240	    qc['dsyn'] = qc['dsyn'] * keep[:, None, None]
   241	    qc['e_d'] = qc['e_d'] * keep[:, None, None]
   242	    qc['e_o'] = qc['e_o'] * keep[:, None]
   243	    valid = qc['valid'] & ~reset
   244	
   245	    # TD error for the previous transition.
   246	    Q, _, _ = qvalues(Wg, Wo, qc['dsyn'], c, X)
   247	    if q.tau_rel:
   248	      # temperature = tau_rel * running mean of the across-action std of Q
   249	      spread = Q.std(-1).mean()
   250	      tau_s = (1 - q.tau_rate) * qc['tau_s'][0] + q.tau_rate * spread
   251	      tau = q.tau_rel * tau_s + 1e-8
   252	    else:
   253	      tau_s = qc['tau_s'][0]
   254	      tau = q.tau
   255	    if q.target:
   256	      # TD target from the slow copies (same dsyn: the episode's state)
   257	      Qt, _, _ = qvalues(Wg_t, Wo_t, qc['dsyn'], c, X)
   258	      V, _ = softmax_value(Qt, tau)
   259	    else:
   260	      V, _ = softmax_value(Q, tau)
   261	    term = obs['is_terminal'].astype(f32)
   262	    r = obs['reward'].astype(f32)
   263	    q_prev_old = qc['q_prev']
   264	    delta = r + q.gamma * (1 - term) * V - q_prev_old
   265	    delta = jnp.where(valid, delta, 0.0)
   266	    # Value-scale normalization (as DreamerV3 retnorm): divide delta by
   267	    # max(limit, S), S = running mean of P_hi - P_lo of the TD targets.
   268	    if q.retnorm:
   269	      y = jnp.where(valid, r + q.gamma * (1 - term) * V, jnp.nan)
   270	      spread = (jnp.nanpercentile(y, q.ret_hi) - jnp.nanpercentile(y, q.ret_lo))
   271	      ret_s = jnp.where(valid.any(), (1 - q.ret_rate) * qc['ret_s'][0]
   272	                        + q.ret_rate * jnp.nan_to_num(spread), qc['ret_s'][0])
   273	      ret_scale = jnp.maximum(q.ret_limit, ret_s)
   274	    else:
   275	      ret_s = qc['ret_s'][0]
   276	      ret_scale = jnp.ones((), f32)
   277	    qc['ret_s'] = ret_s.reshape((1,))
   278	    delta_u = delta / ret_scale
   279	    # Joint normalization over (W_o, dsyn): one NLMS step on the whole
   280	    # parameter vector, with per-group rates beta (fast) and eta (slow).
   281	    if q.trace_norm:
   282	      # normalize by the trace norm, so the change of Q(s_t) per step is at
   283	      # most rate * delta even when the trace has accumulated

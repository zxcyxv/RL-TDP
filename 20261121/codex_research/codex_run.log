import numpy as np

rng = np.random.default_rng(20261121)
n, d, gamma = 4096, 8, 0.9
x = rng.normal(size=(n, d))
next_x = rng.normal(size=(n, d))
r = rng.normal(size=n)
A = 0.1 * np.eye(d)
b = np.zeros(d)
for xt, yt, rt in zip(x, next_x, r):
    A += np.outer(xt, xt - gamma * yt)
    b += xt * rt
w_streaming = np.linalg.solve(A, b)
w_batch = np.linalg.solve(0.1 * np.eye(d) + x.T @ (x - gamma * next_x), x.T @ r)
print('linear LSTD(0) rows/d/max |dw|:', n, d, np.abs(w_batch - w_streaming).max())

n = 16
starts = rng.integers(0, n, size=2048)
actions = rng.integers(0, 2, size=2048)
ends = (starts + 2 * actions - 1) % n
S = np.zeros((n, 2, n), dtype=int)
for s, a, sp in zip(starts, actions, ends):
    S[s, a, sp] += 1
batch = np.bincount((2 * starts + actions) * n + ends, minlength=2 * n**2).reshape(S.shape)
trans = S / S.sum(-1, keepdims=True)
max_error = 0.
for goal in range(n):
    event = (np.arange(n) == goal).astype(float)
    val = np.zeros(n)
    for _ in range(n):
        Q = trans @ (event + gamma * (1.0 - event) * val)
        val = np.max(Q, axis=-1)
    dist = np.minimum((np.arange(n) - goal) % n, (goal - np.arange(n)) % n)
    max_error = max(max_error, np.max(np.abs(val[dist > 0] - gamma**(dist[dist > 0] - 1))))
print('circular goals/observed state-actions/samples:', n, int(np.count_nonzero(S.sum(-1))), len(starts))
print('online counts = batch:', np.array_equal(S, batch), 'max error vs analytical non-goal values:', max_error)

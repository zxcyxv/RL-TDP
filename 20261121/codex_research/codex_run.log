        c, X = features(agent, data)
        print(group, 'states=', c.shape[:2], 'positive transitions=', int((data['reward'] > 0).sum()), flush=True)
        stream_x[group] = trace_metrics(group, c, X, data, o0, w0)
        if group "'!= '"'door':
            continue
        indices = ~data['is_last'].reshape(-1)

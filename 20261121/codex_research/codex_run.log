    43	def features(agent, data):
    44	  T, B = data['reward'].shape
    45	  carry = agent.init_policy(B)
    46	  cs, Xs = [], []
    47	  for t in range(T):
    48	    obs = {k: data[k][t] for k in
    49	           ('image', 'reward', 'is_first', 'is_last', 'is_terminal')}
    50	    with jax.transfer_guard('allow'):
    51	      if t > 0:
    52	        prev = data['action'][t - 1].astype(np.int32)
    53	        carry = (*carry[:3], {'action': [jax.numpy.asarray(a) for a in prev]})
    54	      carry, acts, outs = agent.policy(carry, obs)
    55	    cs.append(np.asarray(outs['qdbg/c'], np.float32))
    56	    Xs.append(np.asarray(outs['qdbg/Xn'], np.float32))
    57	  return np.stack(cs), np.stack(Xs)  # [T, B, n], [T, B, A, d]
    58	
    59	
    60	def silu(u):
    61	  return u / (1 + np.exp(-u))
    62	
    63	
    64	def dsilu(u):
    65	  s = 1 / (1 + np.exp(-u))
    66	  return s * (1 + u * (1 - s))
    67	
    68	
    69	def qvals(Wo, Wg, c, X):
    70	  u = np.einsum('nd,sad->san', Wg, X)
    71	  return np.einsum('n,sn,san->sa', Wo, c, silu(u)), u
    72	
    73	
    74	def softmax(z):
    75	  z = z - z.max(-1, keepdims=True)
    76	  e = np.exp(z)
    77	  return e / e.sum(-1, keepdims=True)

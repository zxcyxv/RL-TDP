    37	    carry = self.agent.init_policy(batch_size)
    38	    a = self.agent
    39	    with jax.transfer_guard('allow'):
    40	      stacked = a._stack(carry[4])
    41	      self.qc = internal.to_global(stacked, a.policy_sharded)
    42	    return carry[:4]
    43	
    44	  def _set(self, Wg, Wo, Wg_t=None, Wo_t=None):
    45	    a = self.agent
    46	    vals = {'q/Wg': Wg, 'q/Wo': Wo}
    47	    if Wg_t is not None:
    48	      vals.update({'q/Wg_t': Wg_t, 'q/Wo_t': Wo_t})
    49	    for key, val in vals.items():
    50	      a.params[key] = jnp.array(val, copy=True)
    51	      a.policy_params[key] = jnp.array(val, copy=True)
    52	      if a.pending_sync:
    53	        a.pending_sync[key] = jnp.array(val, copy=True)

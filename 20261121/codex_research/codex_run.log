   124	                     a=data['action'].reshape(-1).astype(int),
   125	                     near=near.reshape(-1), succ=int((data['reward'] > 0).sum()))
   126	    res[f'{name}_states'] = int(T * B)
   127	    res[f'{name}_successes'] = out[name]['succ']

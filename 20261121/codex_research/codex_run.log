   298	    # Act with the updated fast synapse.
   299	    Q, u, s = qvalues(Wg, Wo, dsyn, c, X)
   300	    logits = Q / tau
   301	    qc['tau_s'] = tau_s.reshape((1,))
   302	    a = jax.random.categorical(nj.seed(), logits, -1).astype(jnp.int32)
   303	    act = {'action': a}
   304	
   305	    # Gradients of Q(s, a) for the chosen action and trace update.
   306	    s_a, u_a, x_a = take(s, a), take(u, a), take(X, a)
   307	    g_o = c * s_a
   308	    coef = Wo[None] * c * dsilu(u_a)
   309	    x_w = x_a @ self.Pmat if self.Pmat is not None else x_a
   310	    g_d = coef[:, :, None] * x_w[:, None, :]
   311	    gl = q.gamma * q.lam
   312	    qc['e_o'] = gl * qc['e_o'] + g_o

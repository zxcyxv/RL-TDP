   193	  def init_train(self, batch_size):
   194	    zeros = lambda x: jnp.zeros((batch_size, *x.shape), x.dtype)
   195	    return (
   196	        self.enc.initial(batch_size),
   197	        self.dyn.initial(batch_size),
   198	        self.dec.initial(batch_size),
   199	        jax.tree.map(zeros, self.act_space))

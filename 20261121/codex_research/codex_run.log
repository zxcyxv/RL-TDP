    96	
    97	        # get rooms
    98	        first_room_mask = mask_by_coordinates(
    99	            grid, (jnp.asarray(self.height), door_col), jnp.less
   100	        )
   101	        first_room = jnp.where(first_room_mask, grid, -1)  # put walls where not mask
   102	        second_room_mask = mask_by_coordinates(
   103	            grid, (jnp.asarray(0), door_col), jnp.greater
   104	        )
   105	        second_room = jnp.where(second_room_mask, grid, -1)  # put walls where not mask
   106	
   107	        # set player and goal pos
   108	        if self.random_start:
   109	            player_pos = random_positions(k1, first_room)
   110	            player_dir = random_directions(k2)
   111	            goal_pos = random_positions(k2, second_room)
   112	        else:
   113	            player_pos = jnp.asarray([1, 1])
   114	            player_dir = jnp.asarray(0)
   115	            goal_pos = jnp.asarray([self.height - 2, self.width - 2])
   116	
   117	        # spawn goal and player
   118	        player = Player.create(
   119	            position=player_pos, direction=player_dir, pocket=EMPTY_POCKET_ID
   120	        )
   121	        goals = Goal.create(position=goal_pos, probability=jnp.asarray(1.0))
   122	
   123	        # spawn key
   124	        key_pos = random_positions(k2, first_room, exclude=player_pos)
   125	        keys = Key.create(position=key_pos, id=jnp.asarray(3), colour=PALETTE.YELLOW)
   126	
   127	        # remove the wall beneath the door
   128	        grid = grid.at[tuple(door_pos)].set(0)
   129	
   130	        entities = {
   131	            "player": player[None],
   132	            "key": keys[None],
   133	            "door": doors[None],
   134	            "goal": goals[None],
   135	            "wall": walls,
   136	        }
   137	
   138	        state = State(
   139	            key=key,
   140	            grid=grid,
   141	            cache=cache or RenderingCache.init(grid),
   142	            entities=entities,
   143	        )

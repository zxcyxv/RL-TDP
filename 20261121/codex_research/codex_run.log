   149	        'Q_before_mean': float(Q0[m].mean()),
   150	        'dQ_mean': float(dQ[m].mean()),
   151	        'dQ_abs_mean': float(np.abs(dQ[m]).mean()),
   152	        'action_gap_before_abs_mean': float(np.abs(adv0[m]).mean()),
   153	        'action_gap_change_abs_mean': float(np.abs(dadv[m]).mean()),
   154	        'policy_KL_mean': float(kl[m].mean()),
   155	        'argmax_changed_frac': float((Q0[m].argmax(-1) != Q1[m].argmax(-1)).mean()),
   156	        'first_order_corr': float(np.corrcoef(dQ[m].ravel(), dQ_lin[m].ravel())[0, 1]),
   157	        'units_participation_ratio_mean': float(pr.reshape(len(dQ), -1)[m].mean()),
   158	    }
   159	
   160	  # overlap factors between single reads/writes (taken actions)
   161	  rng = np.random.default_rng(0)
   162	  def pick(d, k):
   163	    i = rng.integers(0, len(d['c']), k)
   164	    xa = d['X'][i, d['a'][i]]
   165	    c = d['c'][i]

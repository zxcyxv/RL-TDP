    64	class QHead(nj.Module):
    65	
    66	  def __init__(self, n, d, gscale, seed, wo_std=0.0):
    67	    self.n, self.d, self.gscale, self.seed = n, d, gscale, seed
    68	    self.wo_std = wo_std
    69	
    70	  def __call__(self):
    71	    def init_wg():
    72	      key = jax.random.PRNGKey(self.seed)
    73	      return self.gscale / np.sqrt(self.d) * jax.random.normal(
    74	          key, (self.n, self.d), f32)
    75	    Wg = self.value('Wg', init_wg)
    76	    def init_wo():
    77	      # zero, or random once (initialized once, never resampled)
    78	      if not self.wo_std:
    79	        return jnp.zeros((self.n,), f32)
    80	      key = jax.random.PRNGKey(self.seed + 1)
    81	      return self.wo_std * jax.random.normal(key, (self.n,), f32)
    82	    Wo = self.value('Wo', init_wo)
    83	    self._inits = (init_wg, init_wo)
    84	    return Wg, Wo
    85	
    86	  def targets(self):
    87	    """Slow copies of W_g, W_o used only to compute TD targets."""
    88	    self()
    89	    init_wg, init_wo = self._inits
    90	    return self.value('Wg_t', init_wg), self.value('Wo_t', init_wo)
    91	
    92	  def update_targets(self, Wg_t, Wo_t):
    93	    self.targets()
    94	    self.write('Wg_t', Wg_t)
    95	    self.write('Wo_t', Wo_t)
    96	
    97	  def update(self, dWg, dWo):
    98	    Wg, Wo = self()
    99	    self.write('Wg', Wg + dWg)
   100	    self.write('Wo', Wo + dWo)

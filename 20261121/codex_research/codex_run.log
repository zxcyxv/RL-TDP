    45	class DoorKey(Environment):
    46	    """`Navix-DoorKey-*`. A room split in two by an interior wall with a
    47	    single locked yellow door; a matching key lies in the first half, the
    48	    goal in the second. The agent must pick up the key, unlock and open
    49	    the door, then reach the goal. Default reward/termination (`+1` at
    50	    the goal minus a step cost). The wall column and door row are
    51	    randomised every reset.
    52	
    53	    Attributes:
    54	        random_start: `False` puts the player at a fixed corner of the
    55	            first room; `True` (the `-Random-` ids) samples the player
    56	            and key positions within the first room.
    57	    """
    58	
    59	    random_start: bool = struct.field(pytree_node=False, default=False)
    60	
    61	    def _reset(self, key: Array, cache: Union[RenderingCache, None] = None) -> Timestep:
    62	        # check minimum height and width
    63	        assert (
    64	            self.height > 3
    65	        ), f"Room height must be greater than 3, got {self.height} instead"
    66	        assert (
    67	            self.width > 4
    68	        ), f"Room width must be greater than 5, got {self.width} instead"
    69	
    70	        key, k1, k2, k3, k4 = jax.random.split(key, 5)
    71	
    72	        grid = room(height=self.height, width=self.width)
    73	
    74	        # door positions
    75	        # col can be between 1 and height - 2
    76	        door_col = jax.random.randint(k4, (), 2, self.width - 2)  # col
    77	        # row can be between 1 and height - 2

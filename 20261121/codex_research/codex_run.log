   165	        ret_s=jnp.zeros((1,), f32),
   166	        Wo_new=jnp.zeros((n,), f32),
   167	        Wg_new=jnp.zeros((n, d), f32),
   168	        Wo_t_new=jnp.zeros((n,), f32),
   169	        Wg_t_new=jnp.zeros((n, d), f32),
   170	        stats=dict(dWo_zero_disc_cum=jnp.zeros((1,), f32),
   171	                   dWo_zero_chg_cum=jnp.zeros((1,), f32),
   172	                   zero_q_prev=jnp.zeros((1,), f32),
   173	                   zero_V=jnp.zeros((1,), f32),
   174	                   dWo_pos_cum=jnp.zeros((1,), f32),
   175	                   dWo_zero_cum=jnp.zeros((1,), f32),
   176	                   delta_abs=jnp.zeros((1,), f32), delta_max=jnp.zeros((1,), f32),
   177	                   dsyn_norm=jnp.zeros((1,), f32), q_sel=jnp.zeros((1,), f32),
   178	                   u_std=jnp.zeros((1,), f32), transfers=jnp.zeros((1,), f32),
   179	                   tau=jnp.zeros((1,), f32), pi_maxprob=jnp.zeros((1,), f32),

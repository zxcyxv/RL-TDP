    63	    data = {k: v[start:start + steps] for k, v in data.items()}
    64	    out.append(data)
    65	  n = min(len(d['reward']) for d in out)
    66	  return {k: np.stack([d[k][:n] for d in out], 1) for k in keys}  # [T, B]

    33	def load_streams(replay_dir, nstreams, steps):
    34	  files = sorted(pathlib.Path(replay_dir).glob('*.npz'))
    35	  by_uuid, succ_of = {}, {}
    36	  for f in files:
    37	    time, uuid, succ, length = f.stem.split('-')
    38	    by_uuid[uuid] = f
    39	    succ_of[uuid] = succ
    40	  preds = set(succ_of.values())
    41	  heads = [u for u in by_uuid if u not in preds]
    42	  chains = []
    43	  for h in heads:
    44	    chain, u = [], h
    45	    while u in by_uuid:
    46	      chain.append(u)
    47	      u = succ_of[u]
    48	    chains.append(chain)
    49	  chains.sort(key=len, reverse=True)
    50	  keys = ('image', 'reward', 'is_first', 'is_last', 'is_terminal', 'action')
    51	  out = []
    52	  need = steps + 600
    53	  for chain in chains[:nstreams]:
    54	    parts, total = [], 0
    55	    for u in reversed(chain):  # most recent data
    56	      d = np.load(by_uuid[u])
    57	      parts.insert(0, {k: d[k] for k in keys})
    58	      total += len(d['reward'])

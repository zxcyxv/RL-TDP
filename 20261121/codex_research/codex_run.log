    55	  @elements.timer.section('qwrapper_policy')
    56	  def policy(self, carry, obs, mode='train'):
    57	    a = self.agent
    58	    for key, space in a.obs_space.items():
    59	      assert np.isfinite(obs[key]).all(), (obs[key], key, space)
    60	    with a.policy_lock:
    61	      dobs = internal.device_put(obs, a.policy_sharded)
    62	      with a.n_actions.lock:
    63	        counter = a.n_actions.value
    64	        a.n_actions.value += 1
    65	      seed = a._seeds(counter, a.policy_mirrored)
    66	      gcarry = internal.to_global(a._stack(carry), a.policy_sharded)
    67	      gcarry, acts, outs = a._policy(
    68	          a.policy_params, seed, (*gcarry, self.qc), dobs, mode)
    69	      if a.pending_sync:
    70	        old = a.policy_params
    71	        a.policy_params = a.pending_sync
    72	        jax.tree.map(lambda x: x.delete(), old)
    73	        a.pending_sync = None
    74	    self.qc = gcarry[4]
    75	    with jax.transfer_guard('allow'):

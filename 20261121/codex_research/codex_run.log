rng = np.random.default_rng(0)
a_test = a[rng.integers(len(a), size=1200)]
b_test = b[rng.integers(len(b), size=1200)]
I = np.eye(a.shape[1])
Ca, Cb = a.T @ a / len(a), b.T @ b / len(b)
for name, matrix in [('C_A', Ca), ('C_A+C_B', Ca+Cb), ('(C_A+C_B)/2', (Ca+Cb)/2), ('16*(C_A+C_B)/2', 16*(Ca+Cb)/2)]:
    Bp = np.linalg.solve(I+matrix, b_test.T).T
    protect = np.abs(np.einsum('nd,nd->n', a_test, Bp)).mean() / np.abs(np.einsum('nd,nd->n', a_test, b_test)).mean()
    keep = np.einsum('nd,nd->n', b_test, Bp).mean() / np.einsum('nd,nd->n', b_test, b_test).mean()
    print(name, 'old/new read relative=', protect, keep, flush=True)

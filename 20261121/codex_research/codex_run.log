    69	def returns(rew, first, last, term, gamma):
    70	  """G_t for the transition t -> t+1; valid only if the episode ends in the
    71	  window. Truncated episodes bootstrap with 0."""
    72	  T, B = rew.shape
    73	  G = np.zeros((T, B))
    74	  valid = np.zeros((T, B), bool)
    75	  for b in range(B):
    76	    g, ended = 0.0, False
    77	    for t in range(T - 1, -1, -1):
    78	      if t + 1 >= T or first[t + 1, b]:
    79	        g = 0.0
    80	        continue
    81	      if last[t + 1, b]:
    82	        g, ended = rew[t + 1, b], True
    83	      else:
    84	        g = rew[t + 1, b] + gamma * g
    85	      G[t, b], valid[t, b] = g, ended
    86	  return G, valid

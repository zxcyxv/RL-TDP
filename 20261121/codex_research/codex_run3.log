from dreamerv3.diag_features import load_streams
from dreamerv3.diag_overlap import features, dsilu, qvals

root = pathlib.Path('/workspace/ext/logs')
base = root / '20261121_0412_q_dk8_target_tracenorm_eta02' / 'ckpt_steps/01800000'
A = root / '20261121_0515_eval_dk8_before'
B = root / '20261121_0540_learn_unlock_freezewo'
P = root / '20261121_0633_learn_unlock_freezewo_prec'
def weights(path):
    with (path / 'agent.pkl').open('rb') as f:
        return pickle.load(f)['params']
w0 = weights(base)
wo = w0['q/Wo'].astype(np.float64)
W_A = w0['q/Wg'].astype(np.float64)
W_B = weights(B / 'ckpt_steps/00500000')['q/Wg'].astype(np.float64)
W_P = weights(P / 'ckpt_steps/00500000')['q/Wg'].astype(np.float64)
D = W_B-W_A
conf = yaml.YAML(typ='safe').load(pathlib.Path('dreamerv3/configs.yaml').read_text())
config = elements.Config(conf['defaults']).update(conf['size1m'])

def logpolicy(q):
    log = q / q.std(-1).mean()
    log -= log.max(-1, keepdims=True)
    return log - np.log(np.exp(log).sum(-1, keepdims=True))

def evaluate(W, split):
    (c, X, target, t_logp) = split
    q, _ = qvals(wo, W, c, X)
    err = q - target
    centered = err - err.mean(-1, keepdims=True)
    return [float(np.sqrt(np.mean(centered**2))),
            float(np.mean(q.argmax(axis=-1) == target.argmax(axis=-1))),
            float(np.mean(np.sum(np.exp(t_logp) * (t_logp - logpolicy(q)), axis=-1)))]

with tempfile.TemporaryDirectory(prefix='rltdp-consolidation-diag-') as tmp:
    config = elements.Flags(config).parse([
        '--task', 'navix_DoorKey-8x8-v0', '--agent_type', 'q',
        '--agent.dyn.rssm.unroll', 'True', '--logdir', tmp,
        '--agent.q.debug_outs', 'True', '--agent.q.beta', '0',
        '--agent.q.eta', '0', '--agent.q.frozen', 'True', '--run.envs', '16'])
    agent = main.make_agent(config)
    elements.checkpoint.load(str(base), dict(agent=agent.load))
    Cs, coeffs, diag, splits = [], [], [], []
    for source, W in [(A, W_A), (B, W_B)]:
        data = load_streams(source / 'replay', 16, 512)
        c, X = features(agent, data)
        mask = ~data['is_last'][:, :8]
        cf = c[:, :8][mask].astype(np.float64)
        Xf = X[:, :8][mask].astype(np.float64)
        U = Xf @ W.T
        G = (wo * cf)[:, None, :] * dsilu(U)
        xf = Xf.reshape(-1, Xf.shape[-1])
        gf = G.reshape(-1, G.shape[-1])
        Cs.append(xf.T @ xf / len(xf))
        coeffs.append(np.square(gf).mean(0))
        diag.append(np.square(gf).T @ np.square(xf) / len(xf))
        mask = ~data['is_last'][:, 8:]
        cv = c[:, 8:][mask].astype(np.float64)
        Xv = X[:, 8:][mask].astype(np.float64)
        q, _ = qvals(wo, W, cv, Xv)
        splits.append((cv, Xv, q, logpolicy(q)))
        print(source.name, 'held=', len(cv), flush=True)

CA, CB = Cs
I = np.eye(len(CA))
reg = 1e-4 * (CA.trace() + CB.trace()) / (2 * len(CA))
mA, mB = coeffs
pA, pB = diag
opts = [('old', W_A), ('latest', W_B), ('precision', W_P)]
L = np.linalg.cholesky(CA + CB + 2*reg*I)
Z = np.linalg.solve(L, CB+reg*I)
whitened = np.linalg.solve(L, Z.T).T
eig, U = np.linalg.eigh(0.5*(whitened+whitened.T))
bhat = U.T @ np.linalg.solve(L, CB @ D.T)
for rho in [.1, .3, 1., 3., 10.]:
    opts.append((f'average {rho}', W_A + D/(rho+1)))
    opts.append((f'full {rho}', W_A + np.linalg.solve(CB + rho*CA + (rho+1)*reg*I, CB@D.T).T))
    denominator = (rho*mA)[None, :] * (1.-eig[:, None]) + eig[:, None] * mB[None, :]
    coords = bhat * mB[None, :] / np.maximum(denominator, 1e-30)
    opts.append((f'preact row {rho}', W_A + np.linalg.solve(L.T, U@coords).T))
    new_frac = pB / (rho*pA + pB + 1e-12)
    opts.append((f'diag {rho}', W_A + new_frac*D))
for name, W in opts:
    sysA, sysB = [evaluate(W, split) for split in splits]
    print(name, 'A rms/agree/KL', *[round(z, 5) for z in sysA],
          'B rms/agree/KL', *[round(z, 5) for z in sysB], flush=True)

import numpy as np

rng = np.random.default_rng(20261121)
length, inputs, outputs = 34, 12, 7
keys = rng.normal(size=(length, inputs))
vals = rng.normal(size=(length, outputs))
gains = rng.normal(size=length)
query = rng.normal(size=inputs)
D = np.zeros((outputs, inputs))
E = np.zeros_like(D)
g = .99 * .9
for k, m, z in zip(keys, vals, gains):
    E = g * E + np.outer(m, k)
    D += z * E
credits = np.array([sum(gains[j] * g**(j-i) for j in range(i, length))
                    for i in range(length)])
direct = (credits * (keys @ query)) @ vals
np.testing.assert_allclose(D @ query, direct, rtol=1e-12, atol=1e-12)
print('current fast write expansion max absolute error', np.max(np.abs(D @ query - direct)))

ks = np.array([1., -1.])
prob = np.exp(ks) / np.exp(ks).sum()
first, second = np.array([1., 0.]), np.array([2., 1.])
assert ks @ first == ks @ second
assert np.isclose(prob @ second - prob @ first, 1.)
print('identical linear memory, two softmax reads', prob @ first, prob @ second)

pA = rng.normal(size=(160, 8)); pA[:, 5:] = 0
pB = rng.normal(size=(210, 8)); pB[:, 6:] = 0
WA = rng.normal(size=(7, 8)); WB = rng.normal(size=(7, 8))
CA, CB = pA.T@pA/len(pA), pB.T@pB/len(pB)
C, B = CA + CB, WA@CA + WB@CB
pinv = np.linalg.pinv(C, hermitian=True, rtol=C.shape[0]*np.finfo(C.dtype).eps)
W = WB + (B-WB@C)@pinv
x = np.vstack([pA/np.sqrt(len(pA)), pB/np.sqrt(len(pB))])
y = np.vstack([pA@WA.T/np.sqrt(len(pA)), pB@WB.T/np.sqrt(len(pB))])
reference = np.linalg.lstsq(x, y, rcond=None)[0].T
np.testing.assert_allclose(x@W.T, x@reference.T, rtol=1e-12, atol=1e-12)
np.testing.assert_allclose(W[:, 6:], WB[:, 6:])
print('compressed versus batch regression max prediction error', np.max(np.abs(x @ (W-reference).T)))

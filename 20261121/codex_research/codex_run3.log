import pathlib
import pickle
import tempfile

import elements
import numpy as np
import ruamel.yaml as yaml

from dreamerv3 import main
from dreamerv3.diag_features import load_streams
from dreamerv3.diag_overlap import features, silu

root = pathlib.Path('/workspace/ext/logs')
base = root / '20261121_0412_q_dk8_target_tracenorm_eta02' / 'ckpt_steps/01800000'
A = root / '20261121_0515_eval_dk8_before'
B = root / '20261121_0540_learn_unlock_freezewo'
with (base / 'agent.pkl').open('rb') as f:
    p = pickle.load(f)['params']
with (B / 'ckpt_steps/00500000/agent.pkl').open('rb') as f:
    new = pickle.load(f)['params']
w = np.asarray(p['q/Wo'], np.float64)
W = np.asarray(p['q/Wg'], np.float32)
W_B = np.asarray(new['q/Wg'], np.float32)
np.testing.assert_array_equal(w, new['q/Wo'])

cfg = yaml.YAML(typ='safe').load(pathlib.Path('dreamerv3/configs.yaml').read_text())
config = elements.Config(cfg['defaults']).update(cfg['size1m'])

def cf(g, X, W):
    return g[..., None, :] * silu(X @ W.T)

def adv(x):
    return x - x.mean(axis=-1, keepdims=True)

def norm(x):
    return float(np.sqrt(np.mean(x**2)))

def logpolicy(q):
    logits = q / q.std(-1).mean()
    z = logits - logits.max(-1, keepdims=True)
    return z - np.log(np.exp(z).sum(-1, keepdims=True))

def stats(K, target):
    K = K.reshape(-1, K.shape[-1]).astype(np.float64)
    return K.T @ K / len(K), K.T @ target.ravel() / len(K)

def score(X, target, original, w_delta):
    q = original + X @ w_delta
    lp = logpolicy(target)
    return (norm(q - target), norm(adv(q - target)),
            float(np.mean(np.argmax(q, axis=-1) == np.argmax(target, axis=-1))),
            float(np.mean(np.sum(np.exp(lp) * (lp - logpolicy(q)), axis=-1))))

with tempfile.TemporaryDirectory(prefix='rltdp-head-diag-') as tmp:
    config = elements.Flags(config).parse([
        '--task', 'navix_DoorKey-8x8-v0', '--agent_type', 'q',
        '--agent.dyn.rssm.unroll', 'True', '--logdir', tmp,
        '--agent.q.debug_outs', 'True', '--agent.q.beta', '0',
        '--agent.q.eta', '0', '--agent.q.frozen', 'True',
        '--run.envs', '16'])
    agent = main.make_agent(config)
    elements.checkpoint.load(str(base), dict(agent=agent.load))
    train, test = {}, {}
    for name, source in [('A', A), ('B', B)]:
        data = load_streams(source / 'replay', 16, 512)
        c, X = features(agent, data)
        F = cf(c, X, W)
        initial = F @ w
        trained = cf(c, X, W_B) @ w
        target = initial if name == 'A' else trained
        m_fit = ~data['is_last'][:, :8]
        m_test = ~data['is_last'][:, 8:]
        F_fit = F[:, :8][m_fit]
        target_fit = target[:, :8][m_fit] - initial[:, :8][m_fit]
        train[name] = {
            'Q': stats(F_fit, target_fit),
            'A': stats(F_fit - F_fit.mean(axis=-2, keepdims=True), adv(target_fit)),
        }
        test[name] = (F[:, 8:][m_test], target[:, 8:][m_test], initial[:, 8:][m_test])
        if name == 'A':
            print('A direct Unlock write vs A old target',
                'adv-rms', norm(adv(trained[:, 8:][m_test] - initial[:, 8:][m_test])),
                'greedy mismatch', float((trained[:, 8:][m_test].argmax(-1) "'!= initial[:, 8:][m_test].argmax(-1)).mean()), flush=True)
        print('"'group=', name, 'fit/held', int(m_fit.sum()), int(m_test.sum()),
              'held base-to-target Q rms/adv rms/match/KL', score(*test[name], np.zeros(len(w))), flush=True)

    for loss in ['Q', 'A']:
        SA, bA = train['A'][loss]
        SB, bB = train['B'][loss]
        diag = SB.trace() / len(w)
        for keep_old in [0., .1, 1., 10.]:
            for ridge in [1e-6, 1e-3]:
                M = keep_old * SA + SB + ridge * diag * np.eye(len(w))
                dW = np.linalg.solve(M, bB)
                print('loss', loss, 'ratio A/B', keep_old, 'ridge', ridge, 'norm delta/old', np.linalg.norm(dW)/np.linalg.norm(w),
                    'A', score(*test['A'], dW), 'B', score(*test['B'], dW), flush=True)

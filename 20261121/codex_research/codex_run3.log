import pathlib
import pickle
import tempfile

import elements
import numpy as np
import ruamel.yaml as yaml

from dreamerv3 import main
from dreamerv3.diag_features import load_streams
from dreamerv3.diag_overlap import features, qvals

root = pathlib.Path('/workspace/ext/logs')
path_a = root / '20261121_0515_eval_dk8_before'
path_b = root / '20261121_0540_learn_unlock_freezewo'
path_p = root / '20261121_0633_learn_unlock_freezewo_prec'
base = root / '20261121_0412_q_dk8_target_tracenorm_eta02/ckpt_steps/01800000'
def load(path):
    with (path / 'agent.pkl').open('rb') as f:
        return pickle.load(f)['params']

p = load(base)
wo, wa = p['q/Wo'].astype(float), p['q/Wg'].astype(float)
wb = load(path_b / 'ckpt_steps/00500000')['q/Wg'].astype(float)
wp = load(path_p / 'ckpt_steps/00500000')['q/Wg'].astype(float)
cfg = yaml.YAML(typ='safe').load(pathlib.Path('dreamerv3/configs.yaml').read_text())
cfg = elements.Config(cfg['defaults']).update(cfg['size1m'])

def logp(q):
    z = q/q.std(-1).mean()
    z -= z.max(-1, keepdims=True)
    return z - np.log(np.exp(z).sum(-1, keepdims=True))

moments, hold = [], []
with tempfile.TemporaryDirectory(prefix='rltdp-exact-solve-') as tmp:
    cfg = elements.Flags(cfg).parse([
        '--task', 'navix_DoorKey-8x8-v0', '--agent_type', 'q',
        '--agent.dyn.rssm.unroll', 'True', '--logdir', tmp,
        '--agent.q.debug_outs', 'True', '--agent.q.beta', '0',
        '--agent.q.eta', '0', '--agent.q.frozen', 'True', '--run.envs', '16'])
    agent = main.make_agent(cfg)
    elements.checkpoint.load(str(base), dict(agent=agent.load))
    for path, w in [(path_a, wa), (path_b, wb)]:
        data = load_streams(path / 'replay', 16, 512)
        c, x = features(agent, data)
        fit = ~data['is_last'][:, :8]
        mask = ~data['is_last'][:, 8:]
        xr = x[:, :8][fit].reshape(-1, 512).astype(float)
        moments.append(xr.T @ xr / len(xr))
        xv, cv = x[:, 8:][mask].astype(float), c[:, 8:][mask].astype(float)
        q_t = qvals(wo, w, cv, xv)[0]
        near = np.zeros(data['reward'].shape, dtype=bool)
        for stream in range(16):
            for step in np.flatnonzero(data['reward'][:, stream] > 0):
                near[max(0, step-10):step, stream] = 1
        hold.append((xv, cv, q_t, logp(q_t), near[:, 8:][mask]))

ca, cb = moments
S = ca + cb
target = wa @ ca + wb @ cb
Cinv = np.linalg.pinv(S, hermitian=True, rtol=S.shape[0]*np.finfo(S.dtype).eps)
merge = wb + (target-wb@S) @ Cinv
avg = (wa+wb)/2
print('condition number', np.linalg.cond(S), 'W @ S = B error', np.max(np.abs(merge@S-target)), flush=True)
for tag, W in [('baseline-A',wa),('baseline-B',wb),('precision',wp),('mean',avg),('moment-exact',merge)]:
    for name, (x, c, y, tlogp, near) in zip(('A','B'),hold):
        q = qvals(wo, W, c, x)[0]
        dev = q-y
        ctr = dev-dev.mean(-1,keepdims=True)
        policy_kl = (np.exp(tlogp)*(tlogp-logp(q))).sum(-1)
        hit = q.argmax(-1) == y.argmax(-1)
        print(tag, name, len(near), 'rms', np.sqrt(np.mean(ctr**2)), 'KL', policy_kl.mean(), 'argmax match', hit.mean(), 'last10 count/KL', near.sum(), policy_kl[near].mean(), flush=True)

   219	    s2_not = jnp.sum(jnp.where(~arrived, s2, 0)) / jnp.maximum((~arrived).sum(), 1)
   220	    got_mean = jnp.sum(jnp.where(arrived, got, 0)) / jnp.maximum(arrived.sum(), 1)
   221	
   222	    def sim(plan, ai):
   223	        def f(c, a):
   224	            s, o, e = c
   225	            k = key(o, a)
   226	            e = AL[:, None] * e + k
   227	            yh = M[EP.SLOT] @ (sig(h, o, a, e.reshape(-1))[EP.SLOT] * e.reshape(-1))
   228	            s2, o2, _, _ = ER.env_step(s, a, jnp.array(1), sess["rid"][-1], jnp.array(False), sess["b0"])
   229	            return (s2, o2, e), yh
   230	        _, YH = jax.lax.scan(f, (s_end, O[-1], e), plan)
   231	        yh = YH[ai]
   232	        return (yh @ gB) / (jnp.linalg.norm(yh) * jnp.linalg.norm(gB) + 1e-8), jnp.linalg.norm(yh)

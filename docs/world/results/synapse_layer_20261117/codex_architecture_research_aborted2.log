    95	def write(h, O, acts, stop_t):
    96	    if FORGET == 'mult':
    97	        return write_mult(h, O, acts, stop_t)
    98	    R = jnp.exp(h["lr"])
    99	    Q = jnp.exp(h["lq"]) if "lq" in h else jnp.zeros(EP.NP)          # 과정 잡음 (칸별 q_p I): 매 스텝 P ← P + q_p I
   100	
   101	    @jax.checkpoint
   102	    def f(c, x):
   103	        M, P, e = c
   104	        o, a, o2, t = x
   105	        k = key(o, a)
   106	        e = AL[:, None] * e + k
   107	        mu, _ = wm(o, a)
   108	        s = sig(h, o, a, e.reshape(-1))
   109	        r = feat(o2) - mu
   110	
   111	        def pp(Mp, Pp, sp, rp, Rp, Qp):
   112	            Pp = Pp + Qp * jnp.eye(Pp.shape[0])
   113	            z = sp * e.reshape(-1)
   114	            err = rp - Mp @ z; Pz = Pp @ z; S = Rp + z @ Pz
   115	            M2 = Mp + jnp.outer(err, Pz) / S
   116	            got = (M2 @ z) @ rp / (rp @ rp + 1e-12)
   117	            return M2, Pp - jnp.outer(Pz, Pz) / S, 0.5 * (err @ err / S + EP.H * jnp.log(S)), got
   118	        M2, P2, nll, got = jax.vmap(pp)(M, P, s, r, R, Q)
   119	        keep = t > stop_t
   120	        return (jnp.where(keep, M, M2), jnp.where(keep, P, P2), e), (jnp.where(keep, 0.0, nll.sum()), got[EP.SLOT])
   121	    c0 = (jnp.zeros((EP.NP, EP.H, DZ)), jnp.tile(jnp.eye(DZ), (EP.NP, 1, 1)), jnp.zeros((len(HL), KD)))
   122	    return jax.lax.scan(f, c0, (O[:-1], acts, O[1:], jnp.arange(acts.shape[0])))

    66	            z = sp * e.reshape(-1)
    67	            Mp, Sp, err, Sv = mult_step(Mp, Sp, z, rp, Rp, lp)
    68	            got = (Mp @ z) @ rp / (rp @ rp + 1e-12)
    69	            return Mp, Sp, 0.5 * (err @ err / Sv + EP.H * jnp.log(Sv)), got
    70	        M2, S2, nll, got = jax.vmap(pp)(M, S, s, r, R, lam)
    71	        keep = t > stop_t
    72	        return (jnp.where(keep, M, M2), jnp.where(keep, S, S2), e), (jnp.where(keep, 0.0, nll.sum()), got[EP.SLOT])
    73	    c0 = (jnp.zeros((EP.NP, EP.H, DZ)), jnp.tile(I, (EP.NP, 1, 1)), jnp.zeros((len(HL), KD)))
    74	    with jax.default_matmul_precision("highest"):
    75	        (M, S, e), ys = jax.lax.scan(f, c0, (O[:-1], acts, O[1:], jnp.arange(acts.shape[0])))
    76	        P = jnp.einsum('pij,pkj->pik', S, S)
    77	    return (M, P, e), ys

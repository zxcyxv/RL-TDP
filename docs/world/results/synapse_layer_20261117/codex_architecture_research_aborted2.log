    66	    kp, kf = th["kp"], th["kf"]
    67	    R, Q, sg = jnp.exp(kf["lr"]), jnp.exp(kf["lq"]), jnp.exp(0.5 * kf["ls"])
    68	
    69	    @jax.checkpoint
    70	    def f(c, x):
    71	        M, P, e = c
    72	        o, a, o2, t = x
    73	        e, ell = step_e(kp, e, o, a)
    74	        mu, _ = wm(o, a)
    75	        r = feat(o2) - mu
    76	
    77	        def pp(Mp, Pp, sp, rp, Rp, Qp, ep):
    78	            Pp = Pp + Qp * jnp.eye(DZ)
    79	            z = sp * ep.reshape(-1)
    80	            err = rp - Mp @ z; Pz = Pp @ z; S = Rp + R0 + z @ Pz             # R0: 관측 잡음 바닥 (8비트 양자화)
    81	            M2 = Mp + jnp.outer(err, Pz) / S
    82	            got = (M2 @ z) @ rp / (rp @ rp + 1e-12)
    83	            return M2, Pp - jnp.outer(Pz, Pz) / S, 0.5 * (err @ err / S + EP.H * jnp.log(S)), got
    84	        M2, P2, nll, got = jax.vmap(pp)(M, P, sg, r, R, Q, e)
    85	        keep = t > stop_t
    86	        return (jnp.where(keep, M, M2), jnp.where(keep, P, P2), e), (jnp.where(keep, 0.0, nll.sum()), got[EP.SLOT], ell[EP.SLOT], e[EP.SLOT].reshape(-1))
    87	    c0 = (jnp.zeros((EP.NP, EP.H, DZ)), jnp.tile(jnp.eye(DZ), (EP.NP, 1, 1)), jnp.zeros((EP.NP, NPOLE, KD)))
    88	    return jax.lax.scan(f, c0, (O[:-1], acts, O[1:], jnp.arange(acts.shape[0])))
    89	

   206	def decomp_one(th, sess, plans, ai_all):
   207	    """도착 칸 읽기 ŷ_i = M_T z_i = Σ_t w_t r_t 를 과거 쓰기 스텝별 가중치로 분해.
   208	    M_{t+1} = M_t A_t + r_t g_tᵀ, A_t = I − z_t g_tᵀ  →  w_t = g_tᵀ u_{t+1}, u_t = A_t u_{t+1}, u_T = z_i."""
   209	    kp, kf = th["kp"], th["kf"]
   210	    S_ = EP.SLOT
   211	    R, Q, sg = jnp.exp(kf["lr"][S_]), jnp.exp(kf["lq"][S_]), jnp.exp(0.5 * kf["ls"][S_])
   212	    O, s_end, _ = EL.observe_stream(sess)
   213	    t_c = RU.last_arrival(O)
   214	    T = sess["acts"].shape[0]
   215	    # 스텝별 시작 채집처 → 도착 스텝의 채집처
   216	    s0, _ = EL.env0(sess)
   217	    change = jnp.arange(T) == sess["change_t"]
   218	    def fenv(c, x):
   219	        st, cur = c
   220	        a, rq, ri, ch = x
   221	        st2, o2, _, site = ER.env_step(st, a, rq, ri, ch, sess["b0"])
   222	        cur = jnp.where(site >= 0, site, cur)
   223	        return (st2, cur), cur
   224	    _, cur_site = jax.lax.scan(fenv, (s0, jnp.array(-1)), (sess["acts"], sess["req"], sess["rid"], change))
   225	    blank = ER.TEX[ER.BLANK].reshape(-1)
   226	    arrived = ~jnp.all(jnp.isclose(O[1:, S_], blank), -1)                       # 쓰기 스텝 t의 목표 o_{t+1}에 도착
   227	    items = ER.TEX[ER.ITEM0:ER.ITEM0 + 3].reshape(3, -1)
   228	    item = jnp.argmin(jnp.sum((O[1:, S_][:, None] - items[None]) ** 2, -1), -1)
   229	    # 도착 칸 쓰기 순서열 (z_t, g_t, r_t)
   230	    def fw(c, x):
   231	        Mp, Pp, e = c
   232	        o, a, o2, t = x
   233	        e, _ = step_e(kp, e, o, a)
   234	        mu, _ = wm(o, a)
   235	        r = (feat(o2) - mu)[S_]
   236	        Pp = Pp + Q * jnp.eye(DZ)
   237	        z = sg * e[S_].reshape(-1)
   238	        err = r - Mp @ z; Pz = Pp @ z; Sv = R + R0 + z @ Pz
   239	        g = Pz / Sv
   240	        keep = t > t_c
   241	        Mn = jnp.where(keep, Mp, Mp + jnp.outer(err, g)); Pn = jnp.where(keep, Pp, Pp - jnp.outer(Pz, Pz) / Sv)
   242	        return (Mn, Pn, e), (z, jnp.where(keep, 0.0, 1.0) * g, r)
   243	    c0 = (jnp.zeros((EP.H, DZ)), jnp.eye(DZ), jnp.zeros((EP.NP, NPOLE, KD)))
   244	    (MT, _, e_end), (Z, G, Rr) = jax.lax.scan(fw, c0, (O[:-1], sess["acts"], O[1:], jnp.arange(T)))
   245	    def probe_z(plan, ai):
   246	        def f(c, a):
   247	            st, o, e = c
   248	            e, _ = step_e(kp, e, o, a)
   249	            st2, o2, _, _ = ER.env_step(st, a, jnp.array(1), sess["rid"][-1], jnp.array(False), sess["b0"])
   250	            return (st2, o2, e), sg * e[S_].reshape(-1)
   251	        _, Zs = jax.lax.scan(f, (s_end, O[-1], e_end), plan)
   252	        return Zs[ai]
   253	    Zq = jax.vmap(probe_z)(plans, ai_all)                                          # [NSITE, DZ]
   254	    def weights(zq):
   255	        def fb(u, x):
   256	            z, g = x
   257	            w = g @ u
   258	            return u - z * w, w
   259	        _, W = jax.lax.scan(fb, zq, (Z, G), reverse=True)
   260	        return W
   261	    W = jax.vmap(weights)(Zq)                                                      # [NSITE, T]
   262	    yh_direct = Zq @ MT.T                                                          # [NSITE, 8]
   263	    yh_sum = W @ Rr
   264	    gBn = gB / jnp.linalg.norm(gB)
   265	    b0, b1 = sess["b0"], sess["b1"]
   266	    cat = jnp.stack([arrived & (cur_site == b1),
   267	                     arrived & (cur_site == b0) & (item == 1),
   268	                     arrived & (cur_site == b0) & (item == 2),
   269	                     arrived & (cur_site != b0) & (cur_site != b1),
   270	                     ~arrived], 0)                                               # [5, T]
   271	    wsum = jnp.einsum('st,ct->sc', W, cat)                                         # [NSITE, 5] 가중치 합
   272	    bproj = jnp.einsum('st,ct,t->sc', W, cat, Rr @ gBn)                           # [NSITE, 5] B 방향 기여
   273	    ncnt = cat.sum(1)
   274	    return wsum, bproj, ncnt, jnp.max(jnp.abs(yh_direct - yh_sum)), yh_direct

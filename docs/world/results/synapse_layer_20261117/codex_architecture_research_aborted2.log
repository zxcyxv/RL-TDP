    79	
    80	def mult_step(M, S, z, r, Rp, lp):
    81	    """곱하는 망각 한 스텝 (감쇠 뒤 예측, 그다음 쓰기). 반환: M2, S2, 예측 오차, 예측 분산."""
    82	    D = S.shape[0]
    83	    C = lp * jnp.eye(D) + (1 - lp) * (S.T @ S)
    84	    L = jnp.linalg.cholesky(C)
    85	    Ci_St = jax.scipy.linalg.cho_solve((L, True), S.T)                 # C⁻¹ Sᵀ
    86	    M = M - (1 - lp) * (M @ S) @ Ci_St
    87	    S = jax.scipy.linalg.solve_triangular(L, S.T, lower=True).T         # S L⁻ᵀ
    88	    fv = S.T @ z; Sv = Rp + fv @ fv
    89	    err = r - M @ z
    90	    al = 1.0 / Sv; ga = 1.0 / (1.0 + jnp.sqrt(al * Rp))
    91	    K = al * (S @ fv)
    92	    return M + jnp.outer(err, K), S - ga * jnp.outer(K, fv), err, Sv
    93	

   125	# ---- 경험적 베이즈: 학습 세계의 교사 세션 전체의 순차 예측 NLL
   126	_, tr = EL.stack_sessions(range(50_000, 50_000 + 256), 256)
   127	h = dict(ls=jnp.zeros(EP.NP), lr=jnp.full(EP.NP, jnp.log(0.01)))

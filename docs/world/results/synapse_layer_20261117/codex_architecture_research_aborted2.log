   170	        outs.append(judge_chunk(th, jax.tree_util.tree_map(sl, stack), plans[i:i + JCH], arrive[i:i + JCH], zt))
   171	    sc, nrm, got, ki, km, kw, cx, ce = [np.concatenate([np.array(o[j]) for o in outs]) for j in range(8)]
   172	    best = (sc + 1e-9 * np.random.default_rng(0).random(sc.shape)).argmax(1)
   173	    return dict(b1=float(np.mean(best == b1)), b0=float(np.mean(best == b0)),
   174	                other=float(np.mean((best != b1) & (best != b0))),
   175	                written=float(np.mean(got)), read_norm=float(np.mean(nrm)),
   176	                ksize_interact=float(np.mean(ki)), ksize_move=float(np.mean(km)), ksize_wait=float(np.mean(kw)),
   177	                cos_addr_neighbor=float(np.mean(cx)), cos_trace_neighbor=float(np.mean(ce)),
   178	                per_world_b1=(best == b1).astype(int).tolist())

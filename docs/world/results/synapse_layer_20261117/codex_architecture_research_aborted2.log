   118	def judge_one(th, sess, plans, ai_all, zt=False):
   119	    kp, kf = th["kp"], th["kf"]
   120	    O, s_end, _ = EL.observe_stream(sess)
   121	    t_c = RU.last_arrival(O)
   122	    Y = jax.vmap(feat)(O[1:])[:, EP.SLOT]
   123	    blank = feat(ER.TEX[jnp.full(12, ER.BLANK)].reshape(12, -1))[EP.SLOT]
   124	    arrived = ~jnp.all(jnp.isclose(Y, blank, atol=1e-5), -1)
   125	    (M, P, e), (_, got, ell, X) = write(th, O, sess["acts"], t_c)
   126	    got_mean = jnp.sum(jnp.where(arrived, got, 0)) / jnp.maximum(arrived.sum(), 1)
   127	    T = sess["acts"].shape[0]
   128	    live = jnp.arange(T) <= t_c
   129	    a_ = sess["acts"]
   130	    def mean_where(v, m):
   131	        return jnp.sum(jnp.where(m, v, 0)) / jnp.maximum(m.sum(), 1)
   132	    ksz = jnp.exp(ell)
   133	    k_int = mean_where(ksz, live & (a_ == ER.INTERACT))
   134	    k_mov = mean_where(ksz, live & (a_ < 4))
   135	    k_wait = mean_where(ksz, live & (a_ == ER.WAIT))
   136	    Xn = X / (jnp.linalg.norm(X, axis=-1, keepdims=True) + 1e-12)
   137	    En = X[:, KD:] / (jnp.linalg.norm(X[:, KD:], axis=-1, keepdims=True) + 1e-12)
   138	    l2 = live[1:] & live[:-1]
   139	    cos_x = mean_where(jnp.sum(Xn[1:] * Xn[:-1], -1), l2)
   140	    cos_e = mean_where(jnp.sum(En[1:] * En[:-1], -1), l2)
   141	    sgs = jnp.exp(0.5 * kf["ls"][EP.SLOT])
   142	
   143	    def sim(plan, ai):
   144	        def f(c, a):
   145	            s, o, e = c
   146	            e, _ = step_e(kp, e, o, a)
   147	            yh = M[EP.SLOT] @ (sgs * e[EP.SLOT].reshape(-1))
   148	            s2, o2, _, _ = ER.env_step(s, a, jnp.array(1), sess["rid"][-1], jnp.array(False), sess["b0"])
   149	            return (s2, o2, e), yh
   150	        _, YH = jax.lax.scan(f, (s_end, O[-1], jnp.zeros_like(e) if zt else e), plan)   # zt: probe를 흔적 0에서 시작
   151	        yh = YH[ai]
   152	        return (yh @ gB) / (jnp.linalg.norm(yh) * jnp.linalg.norm(gB) + 1e-8), jnp.linalg.norm(yh)
   153	    sc, nrm = jax.vmap(sim)(plans, ai_all)
   154	    return sc, nrm, got_mean, k_int, k_mov, k_wait, cos_x, cos_e

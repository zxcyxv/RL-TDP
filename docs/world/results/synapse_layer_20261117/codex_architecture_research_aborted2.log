   205	def one(sess, plans, ai_all):
   206	    O, s_end, _ = EL.observe_stream(sess)
   207	    t_c = RU.last_arrival(O)
   208	    Y = jax.vmap(feat)(O[1:])[:, EP.SLOT]
   209	    blank = feat(ER.TEX[jnp.full(12, ER.BLANK)].reshape(12, -1))[EP.SLOT]
   210	    arrived = ~jnp.all(jnp.isclose(Y, blank, atol=1e-5), -1)
   211	    (M, P, e), (_, got) = write(h, O, sess["acts"], t_c)
   212	
   213	    def fx(e_, inp):
   214	        o_, a_ = inp
   215	        e_ = AL[:, None] * e_ + key(o_, a_)
   216	        return e_, sig(h, o_, a_, e_.reshape(-1))[EP.SLOT] ** 2
   217	    _, s2 = jax.lax.scan(fx, jnp.zeros((len(HL), KD)), (O[:-1], sess["acts"]))

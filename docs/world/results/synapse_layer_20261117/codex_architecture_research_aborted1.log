    56	def write(th, O, acts, stop_t):
    57	    kp, kf = th["kp"], th["kf"]
    58	    R, q, sg = jnp.exp(kf["lr"]), jnp.exp(kf["lq"]), jnp.exp(0.5 * kf["ls"])
    59	
    60	    @jax.checkpoint
    61	    def f(c, x):
    62	        M, P, e = c
    63	        o, a, o2, t = x
    64	        e, X, ell = step_e(kp, e, o, a)
    65	        mu, _ = wm(o, a)
    66	        r = feat(o2) - mu
    67	        Z = sg[:, None] * X                                                 # [12, DZ]
    68	        P0 = P + q * jnp.eye(DZ)
    69	
    70	        # 배치 칼만: 칸 12개를 한 번에 (관측 잡음 독립 → 순차 12번과 같은 사후·결합 우도)
    71	        E = r - Z @ M.T                                                     # [12, 8] 쓰기 전 오차
    72	        PZ = Z @ P0                                                         # [12, DZ] (P 대칭)
    73	        S = PZ @ Z.T + jnp.diag(R)                                          # [12, 12]
    74	        L = jnp.linalg.cholesky(S)

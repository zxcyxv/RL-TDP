   117	def judge_one(th, sess, plans, ai_all):
   118	    kp, kf = th["kp"], th["kf"]
   119	    O, s_end, _ = EL.observe_stream(sess)
   120	    t_c = RU.last_arrival(O)
   121	    Y = jax.vmap(feat)(O[1:])[:, EP.SLOT]
   122	    blank = feat(ER.TEX[jnp.full(12, ER.BLANK)].reshape(12, -1))[EP.SLOT]
   123	    arrived = ~jnp.all(jnp.isclose(Y, blank, atol=1e-5), -1)
   124	    (M, P, e), (_, got, ell, X) = write(th, O, sess["acts"], t_c)
   125	    got_mean = jnp.sum(jnp.where(arrived, got, 0)) / jnp.maximum(arrived.sum(), 1)
   126	    T = sess["acts"].shape[0]
   127	    live = jnp.arange(T) <= t_c
   128	    a_ = sess["acts"]
   129	    def mean_where(v, m):
   130	        return jnp.sum(jnp.where(m, v, 0)) / jnp.maximum(m.sum(), 1)
   131	    ksz = jnp.exp(ell)
   132	    k_int = mean_where(ksz, live & (a_ == ER.INTERACT))
   133	    k_mov = mean_where(ksz, live & (a_ < 4))
   134	    k_wait = mean_where(ksz, live & (a_ == ER.WAIT))
   135	    Xn = X / (jnp.linalg.norm(X, axis=-1, keepdims=True) + 1e-12)
   136	    En = X[:, KD:] / (jnp.linalg.norm(X[:, KD:], axis=-1, keepdims=True) + 1e-12)
   137	    l2 = live[1:] & live[:-1]
   138	    cos_x = mean_where(jnp.sum(Xn[1:] * Xn[:-1], -1), l2)
   139	    cos_e = mean_where(jnp.sum(En[1:] * En[:-1], -1), l2)
   140	    sgs = jnp.exp(0.5 * kf["ls"][EP.SLOT])
   141	
   142	    def sim(plan, ai):
   143	        def f(c, a):
   144	            s, o, e = c
   145	            e, X, _ = step_e(kp, e, o, a)
   146	            yh = M @ (sgs * X[EP.SLOT])
   147	            s2, o2, _, _ = ER.env_step(s, a, jnp.array(1), sess["rid"][-1], jnp.array(False), sess["b0"])
   148	            return (s2, o2, e), yh
   149	        _, YH = jax.lax.scan(f, (s_end, O[-1], e), plan)
   150	        yh = YH[ai]
   151	        return (yh @ gB) / (jnp.linalg.norm(yh) * jnp.linalg.norm(gB) + 1e-8), jnp.linalg.norm(yh)
   152	    sc, nrm = jax.vmap(sim)(plans, ai_all)
   153	    return sc, nrm, got_mean, k_int, k_mov, k_wait, cos_x, cos_e
